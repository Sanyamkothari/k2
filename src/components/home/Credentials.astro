---
import { credentials } from '../../lib/site';
---

<section class="creds container-x" aria-label="Credentials">
  <dl class="creds__grid" data-reveal-group>
    {credentials.map((c) => (
      <div class="creds__item">
        <dd class="creds__num tnum" data-count={c.value} data-suffix={c.suffix}>{c.value}{c.suffix}</dd>
        <dt class="label muted">{c.label}</dt>
      </div>
    ))}
  </dl>
</section>

<style>
  .creds { padding-block: var(--section-sm); }
  .creds__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0; border-top: 1px solid var(--color-rule); }
  @media (min-width: 48rem) { .creds__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .creds__item { padding: 1.5rem 1.25rem 1.5rem 0; border-bottom: 1px solid var(--color-rule); }
  .creds__item + .creds__item { border-left: 1px solid var(--color-rule); padding-left: 1.25rem; }
  @media (max-width: 47.99rem) { .creds__item:nth-child(3) { border-left: 0; padding-left: 0; } }
  .creds__num { font-family: var(--font-display); font-size: var(--text-3xl); line-height: 1; letter-spacing: -0.03em; margin: 0 0 0.6rem; }
  dt { margin: 0; }
</style>

<script>
  import { animate, inView } from 'motion';
  function initCounters() {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      if (el.dataset.done) return;
      el.dataset.done = '1';
      const target = Number(el.dataset.count);
      const suffix = el.dataset.suffix || '';
      if (reduced) { el.textContent = `${target}${suffix}`; return; }
      el.textContent = `0${suffix}`;
      inView(el, () => {
        animate(0, target, { duration: 1.4, ease: [0.22, 1, 0.36, 1], onUpdate: (v) => { el.textContent = `${Math.round(v)}${suffix}`; } });
      }, { amount: 0.6 });
    });
  }
  document.addEventListener('astro:page-load', initCounters);
</script>
