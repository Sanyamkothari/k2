---
import { rendition } from '../../lib/images';
import { heroSlides, site } from '../../lib/site';

const slides = heroSlides.map((slide) => ({
  ...slide,
  rendition: rendition(slide.image, { widths: [480, 800, 1200, 1600, 2000], sizes: '100vw' }),
}));

// Clones for infinite seamless looping
const clonePrev = slides[slides.length - 1];
const cloneNext = slides[0];
---

<section class="hero" aria-label="Introduction" aria-roledescription="carousel" id="hero-carousel">
  <div class="hero__viewport figure" data-parallax="8">
    <div class="hero__track" id="hero-track">
      <!-- Clone of last slide (CITM) for infinite backward transition -->
      <div class="hero__slide is-clone" aria-hidden="true">
        <picture>
          {clonePrev.rendition.avifSrcset && <source type="image/avif" srcset={clonePrev.rendition.avifSrcset} sizes="100vw" />}
          <source type="image/webp" srcset={clonePrev.rendition.srcset} sizes="100vw" />
          <img
            src={clonePrev.rendition.src}
            sizes="100vw"
            width={clonePrev.rendition.width}
            height={clonePrev.rendition.height}
            alt=""
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            style="scale:1.14"
          />
        </picture>
      </div>

      <!-- Real Slides: 0 (DPS), 1 (Pragati), 2 (CITM) -->
      {slides.map((slide, i) => (
        <div
          class:list={['hero__slide', { 'is-active': i === 0 }]}
          data-slide-index={i}
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${slides.length}: ${slide.title}, ${slide.location}`}
        >
          <picture>
            {slide.rendition.avifSrcset && <source type="image/avif" srcset={slide.rendition.avifSrcset} sizes="100vw" />}
            <source type="image/webp" srcset={slide.rendition.srcset} sizes="100vw" />
            <img
              src={slide.rendition.src}
              sizes="100vw"
              width={slide.rendition.width}
              height={slide.rendition.height}
              alt={slide.alt}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding={i === 0 ? 'sync' : 'async'}
              fetchpriority={i === 0 ? 'high' : 'low'}
              style="scale:1.14"
            />
          </picture>
        </div>
      ))}

      <!-- Clone of first slide (DPS) for infinite forward transition -->
      <div class="hero__slide is-clone" aria-hidden="true">
        <picture>
          {cloneNext.rendition.avifSrcset && <source type="image/avif" srcset={cloneNext.rendition.avifSrcset} sizes="100vw" />}
          <source type="image/webp" srcset={cloneNext.rendition.srcset} sizes="100vw" />
          <img
            src={cloneNext.rendition.src}
            sizes="100vw"
            width={cloneNext.rendition.width}
            height={cloneNext.rendition.height}
            alt=""
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            style="scale:1.14"
          />
        </picture>
      </div>
    </div>
  </div>

  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__content container-x">
    <h1 class="hero__title display-hero" data-split>Architecture for institutions that last.</h1>

    <div class="hero__aside" data-reveal data-delay="0.6">
      <!-- Slide Metadata & Controls -->
      <div class="hero__slider-meta">
        <div class="hero__caption-wrap" aria-live="polite">
          {slides.map((slide, i) => (
            <a
              href={`/works/${slide.slug}`}
              class:list={['hero__slide-caption label link', { 'is-active': i === 0 }]}
              data-caption-index={i}
              tabindex={i === 0 ? 0 : -1}
              aria-label={`View project: ${slide.title}, ${slide.location}`}
            >
              <span class="hero__caption-idx">{slide.index} / 03</span>
              <span class="hero__caption-title">{slide.title}</span>
              <span class="hero__caption-loc">· {slide.location}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>

        <div class="hero__controls">
          <div class="hero__indicators" role="tablist" aria-label="Slides">
            {slides.map((slide, i) => (
              <button
                type="button"
                role="tab"
                class:list={['hero__indicator', { 'is-active': i === 0 }]}
                data-indicator-index={i}
                aria-label={`Go to slide ${i + 1}: ${slide.title}`}
                aria-selected={i === 0 ? 'true' : 'false'}
              >
                <span class="hero__indicator-line">
                  <span class="hero__indicator-fill"></span>
                </span>
              </button>
            ))}
          </div>

          <div class="hero__arrows">
            <button
              type="button"
              class="hero__arrow hero__arrow--prev"
              id="hero-prev"
              aria-label="Previous slide"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <button
              type="button"
              class="hero__arrow hero__arrow--next"
              id="hero-next"
              aria-label="Next slide"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          </div>
        </div>
      </div>

      <div class="hero__footer-meta">
        <p class="label">{site.city} · Since {site.since}</p>
        <a href="#works" class="hero__cue label" aria-label="Scroll to selected works">Scroll <span class="cue-line" aria-hidden="true"></span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    max-height: 1100px;
    color: #fff;
    overflow: clip;
  }
  .hero__viewport {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .hero__viewport::after {
    opacity: 0.05;
  }
  .hero__track {
    display: flex;
    width: 100%;
    height: 100%;
    will-change: transform;
  }
  .hero__slide {
    position: relative;
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .hero__slide picture,
  .hero__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
    display: block;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to top, rgba(17,17,17,0.78) 0%, rgba(17,17,17,0.38) 32%, rgba(17,17,17,0) 62%),
      linear-gradient(to bottom, rgba(17,17,17,0.3) 0%, rgba(17,17,17,0) 22%);
  }
  .hero__content {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-bottom: clamp(2rem, 5vw, 4rem);
    align-items: end;
  }
  @media (min-width: 64rem) {
    .hero__content {
      grid-template-columns: 8fr 4fr;
    }
  }
  .hero__title {
    max-width: 11ch;
    margin-left: -0.04em;
  }
  .hero__aside {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    opacity: 0.96;
  }
  @media (min-width: 64rem) {
    .hero__aside {
      align-items: flex-end;
      gap: 2rem;
    }
  }

  /* Slide Meta & Controls */
  .hero__slider-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }
  @media (min-width: 64rem) {
    .hero__slider-meta {
      align-items: flex-end;
    }
  }

  .hero__caption-wrap {
    position: relative;
    min-height: 1.5rem;
    display: flex;
    align-items: center;
  }
  .hero__slide-caption {
    position: absolute;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition: opacity 0.5s var(--ease), transform 0.5s var(--ease);
    color: #fff;
  }
  @media (min-width: 64rem) {
    .hero__slide-caption {
      left: auto;
      right: 0;
    }
  }
  .hero__slide-caption.is-active {
    opacity: 0.95;
    transform: translateY(0);
    pointer-events: auto;
  }
  .hero__caption-idx {
    color: rgba(255, 255, 255, 0.65);
    font-variant-numeric: tabular-nums;
  }
  .hero__caption-title {
    font-weight: 500;
  }
  .hero__caption-loc {
    color: rgba(255, 255, 255, 0.8);
  }

  .hero__controls {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .hero__indicators {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hero__indicator {
    padding: 0.5rem 0;
    cursor: pointer;
    display: flex;
    align-items: center;
  }
  .hero__indicator-line {
    display: block;
    width: 1.75rem;
    height: 2px;
    background: rgba(255, 255, 255, 0.28);
    position: relative;
    overflow: hidden;
    border-radius: 1px;
    transition: width 0.35s var(--ease), background-color 0.25s var(--ease);
  }
  .hero__indicator:hover .hero__indicator-line {
    background: rgba(255, 255, 255, 0.55);
  }
  .hero__indicator.is-active .hero__indicator-line {
    width: 3.25rem;
    background: rgba(255, 255, 255, 0.28);
  }
  .hero__indicator-fill {
    position: absolute;
    inset: 0;
    background: #ffffff;
    transform: scaleX(0);
    transform-origin: left;
  }
  .hero__indicator.is-active .hero__indicator-fill {
    animation: heroProgress 6000ms linear forwards;
  }
  @keyframes heroProgress {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }
  .hero:hover .hero__indicator.is-active .hero__indicator-fill {
    animation-play-state: paused;
  }

  .hero__arrows {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .hero__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(17, 17, 17, 0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #fff;
    cursor: pointer;
    transition: background 0.25s var(--ease), border-color 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .hero__arrow:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.6);
    transform: scale(1.05);
  }
  .hero__arrow:active {
    transform: scale(0.95);
  }

  .hero__footer-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    gap: 1.5rem;
    opacity: 0.92;
  }
  @media (min-width: 64rem) {
    .hero__footer-meta {
      flex-direction: column;
      align-items: flex-end;
      gap: 1.75rem;
      width: auto;
    }
  }

  .hero__cue {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .cue-line {
    display: block;
    width: 2.5rem;
    height: 1px;
    background: currentColor;
    transform-origin: left;
    animation: cue 2.4s var(--ease) infinite;
  }
  @keyframes cue {
    0% { transform: scaleX(0); }
    50% { transform: scaleX(1); }
    100% { transform: scaleX(0); transform-origin: right; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__track {
      transition: none !important;
    }
    .hero__indicator-fill {
      animation: none !important;
      transform: scaleX(1) !important;
    }
    .hero__slide-caption {
      transition: none !important;
    }
  }
</style>

<script>
  function initHeroCarousel() {
    const hero = document.getElementById('hero-carousel');
    const track = document.getElementById('hero-track');
    if (!hero || !track) return;
    const trackEl: HTMLElement = track;

    // Avoid duplicate initialization on the same element
    if (trackEl.dataset.carouselInit === 'true') return;
    trackEl.dataset.carouselInit = 'true';

    const totalRealSlides = 3; // DPS (0), Pragati (1), CITM (2)
    let currentIndex = 1; // Track index 1 corresponds to real slide 0
    let isTransitioning = false;
    let timer: ReturnType<typeof setInterval> | null = null;
    const slideDuration = 6000;
    const transitionDuration = 1000;

    const captions = hero.querySelectorAll<HTMLElement>('[data-caption-index]');
    const indicators = hero.querySelectorAll<HTMLElement>('[data-indicator-index]');
    const prevBtn = document.getElementById('hero-prev');
    const nextBtn = document.getElementById('hero-next');

    // Initial setup: align track to slide 0 (track index 1)
    trackEl.style.transition = 'none';
    trackEl.style.transform = `translate3d(-${currentIndex * 100}%, 0, 0)`;

    function getActiveSlideIndex(trackIdx: number) {
      if (trackIdx === 0) return totalRealSlides - 1;
      if (trackIdx === totalRealSlides + 1) return 0;
      return trackIdx - 1;
    }

    function updateUI(activeIdx: number) {
      captions.forEach((cap, i) => {
        const active = i === activeIdx;
        cap.classList.toggle('is-active', active);
        cap.setAttribute('tabindex', active ? '0' : '-1');
        cap.setAttribute('aria-hidden', active ? 'false' : 'true');
      });

      indicators.forEach((ind, i) => {
        const active = i === activeIdx;
        ind.classList.toggle('is-active', active);
        ind.setAttribute('aria-selected', active ? 'true' : 'false');

        const fill = ind.querySelector<HTMLElement>('.hero__indicator-fill');
        if (fill) {
          fill.style.animation = 'none';
          if (active) {
            void fill.offsetHeight; // trigger DOM reflow to restart CSS animation
            fill.style.animation = '';
          }
        }
      });
    }

    function goToTrackIndex(targetTrackIdx: number, animated = true) {
      if (animated) {
        isTransitioning = true;
        trackEl.style.transition = `transform ${transitionDuration}ms cubic-bezier(0.25, 1, 0.35, 1)`;
      } else {
        trackEl.style.transition = 'none';
      }
      trackEl.style.transform = `translate3d(-${targetTrackIdx * 100}%, 0, 0)`;
      currentIndex = targetTrackIdx;
      updateUI(getActiveSlideIndex(targetTrackIdx));
    }

    function handleTransitionEnd() {
      isTransitioning = false;
      // Seamless infinite loop snap
      if (currentIndex === totalRealSlides + 1) {
        // We reached the append-clone of DPS -> snap instantly to real DPS
        goToTrackIndex(1, false);
      } else if (currentIndex === 0) {
        // We reached the prepend-clone of CITM -> snap instantly to real CITM
        goToTrackIndex(totalRealSlides, false);
      }
    }

    trackEl.addEventListener('transitionend', (e) => {
      if (e.target === trackEl && e.propertyName === 'transform') {
        handleTransitionEnd();
      }
    });

    function nextSlide() {
      if (isTransitioning) return;
      goToTrackIndex(currentIndex + 1, true);
    }

    function prevSlide() {
      if (isTransitioning) return;
      goToTrackIndex(currentIndex - 1, true);
    }

    function startTimer() {
      stopTimer();
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduced) return;
      timer = setInterval(() => {
        nextSlide();
      }, slideDuration);
    }

    function stopTimer() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    // Button event listeners
    nextBtn?.addEventListener('click', () => {
      nextSlide();
      startTimer();
    });

    prevBtn?.addEventListener('click', () => {
      prevSlide();
      startTimer();
    });

    // Indicators click listeners
    indicators.forEach((ind) => {
      ind.addEventListener('click', () => {
        if (isTransitioning) return;
        const targetIdx = Number(ind.dataset.indicatorIndex);
        const targetTrackIdx = targetIdx + 1;
        if (targetTrackIdx === currentIndex) return;
        goToTrackIndex(targetTrackIdx, true);
        startTimer();
      });
    });

    // Pause auto-sliding on hover
    hero.addEventListener('mouseenter', stopTimer);
    hero.addEventListener('mouseleave', startTimer);

    // Pause when tab is inactive
    const handleVisibility = () => {
      if (document.hidden) stopTimer();
      else startTimer();
    };
    document.addEventListener('visibilitychange', handleVisibility);

    // Touch swipe support
    let touchStartX = 0;
    let touchStartY = 0;
    hero.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      touchStartY = e.changedTouches[0].screenY;
      stopTimer();
    }, { passive: true });

    hero.addEventListener('touchend', (e) => {
      const touchEndX = e.changedTouches[0].screenX;
      const touchEndY = e.changedTouches[0].screenY;
      const diffX = touchStartX - touchEndX;
      const diffY = touchStartY - touchEndY;
      if (Math.abs(diffX) > 45 && Math.abs(diffX) > Math.abs(diffY)) {
        if (diffX > 0) nextSlide();
        else prevSlide();
      }
      startTimer();
    }, { passive: true });

    // Keyboard arrow keys
    hero.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        nextSlide();
        startTimer();
      } else if (e.key === 'ArrowLeft') {
        prevSlide();
        startTimer();
      }
    });

    // Clean up when leaving page
    document.addEventListener('astro:before-swap', () => {
      stopTimer();
      document.removeEventListener('visibilitychange', handleVisibility);
    }, { once: true });

    startTimer();
  }

  document.addEventListener('astro:page-load', initHeroCarousel);
</script>
