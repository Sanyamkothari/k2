---
import { rendition } from '../../lib/images';
import { hero, site } from '../../lib/site';
const img = rendition(hero.image, { widths: [480, 800, 1200, 1600, 2000], sizes: '100vw' });
---

<section class="hero" aria-label="Introduction">
  <div class="hero__media figure" data-parallax="8">
    <img
      src={img.src}
      srcset={img.srcset}
      sizes="100vw"
      width={img.width}
      height={img.height}
      alt={hero.alt}
      loading="eager"
      decoding="sync"
      fetchpriority="high"
      style="scale:1.14"
    />
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__content container-x">
    <h1 class="hero__title display-hero" data-split>Architecture for institutions that last.</h1>
    <div class="hero__aside" data-reveal data-delay="0.6">
      <p class="label">{site.city} · Since {site.since}</p>
      <a href="#works" class="hero__cue label" aria-label="Scroll to selected works">Scroll <span class="cue-line" aria-hidden="true"></span></a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    max-height: 1100px;
    color: #fff;
    overflow: clip;
  }
  .hero__media { position: absolute; inset: 0; }
  .hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: center 55%; }
  .hero__media::after { opacity: 0.05; }
  .hero__scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(to top, rgba(17,17,17,0.72) 0%, rgba(17,17,17,0.35) 32%, rgba(17,17,17,0) 62%),
      linear-gradient(to bottom, rgba(17,17,17,0.25) 0%, rgba(17,17,17,0) 22%);
  }
  .hero__content {
    position: absolute; inset: auto 0 0 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding-bottom: clamp(2rem, 5vw, 4rem);
    align-items: end;
  }
  @media (min-width: 64rem) { .hero__content { grid-template-columns: 8fr 4fr; } }
  .hero__title { max-width: 11ch; margin-left: -0.04em; }
  .hero__aside { display: flex; justify-content: space-between; align-items: end; gap: 1rem; opacity: 0.92; }
  @media (min-width: 64rem) { .hero__aside { flex-direction: column; align-items: flex-end; gap: 2rem; } }
  .hero__cue { display: inline-flex; align-items: center; gap: 0.75rem; }
  .cue-line { display: block; width: 2.5rem; height: 1px; background: currentColor; transform-origin: left; animation: cue 2.4s var(--ease) infinite; }
  @keyframes cue { 0% { transform: scaleX(0); } 50% { transform: scaleX(1); } 100% { transform: scaleX(0); transform-origin: right; } }
</style>
