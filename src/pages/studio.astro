---
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import { rendition } from '../lib/images';
import { site, sectors, team, clients, clientNames } from '../lib/site';
import { projects } from '../lib/projects';

const sections = [
  { id: 'practice', n: '01', title: 'Practice' },
  { id: 'approach', n: '02', title: 'Approach' },
  { id: 'sectors', n: '03', title: 'Sectors' },
  { id: 'people', n: '04', title: 'People' },
  { id: 'recognition', n: '05', title: 'Recognition & Clients' },
];
const people = team.map((m) => ({ ...m, img: rendition(m.image, { widths: [480, 800], sizes: '(min-width: 48rem) 20vw, 45vw' }) }));
const dps = projects.filter((p) => /Delhi Public School/i.test(p.title)).map((p) => p.city);
const dwps = projects.filter((p) => /Delhi World Public School/i.test(p.title)).map((p) => p.city);
const list = (xs: string[]) => xs.length > 1 ? `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}` : xs[0];
---

<Base title="Studio" description="K2 Architects: a Nagpur practice founded in 1999 by Ar. Sachin Kothari. Institutional architecture across seven Indian states, from campus master plans to hospitals.">
  <section class="studio container-x">
    <header class="studio__head grid-12">
      <h1 class="display-3xl studio__title" data-split>A practice built around institutions.</h1>
      <p class="lede studio__lede" data-reveal data-delay="0.2">Founded in Nagpur in {site.since}. Twenty-five years, 450+ projects, seven states. Led by Ar. Sachin Kothari with Landscape Architect Ar. Riya Kothari.</p>
    </header>

    <div class="studio__hero" data-reveal-img>
      <Picture src="images/DPS KATNI aerial.jpg" alt="Aerial render of the Delhi Public School campus master plan, Katni, Madhya Pradesh, by K2 Architects" ratio="wide" sizes="(min-width: 64rem) 88vw, 92vw" parallax={6} reveal={false} />
      <p class="label muted studio__hero-cap">Delhi Public School, Katni · Campus master plan</p>
    </div>

    <div class="studio__body">
      <aside class="studio__side">
        <nav class="toc" aria-label="On this page" id="toc">
          <ol>
            {sections.map((s) => (
              <li><a href={`#${s.id}`} class="toc__link" data-toc={s.id}><span class="tnum toc__n">{s.n}</span> {s.title}</a></li>
            ))}
          </ol>
        </nav>
      </aside>

      <article class="prose">
        <section id="practice" class="prose__section">
          <h2 class="prose__h display-2xl">Practice</h2>
          <p>K2 Architects is an architectural consultancy based in Nagpur, Maharashtra. The practice provides architectural, technical and engineering services, together with the work that surrounds them: development, project management, building services and installation.</p>
          <p>Since 1999 it has delivered more than 450 projects in Chhattisgarh, Maharashtra, Madhya Pradesh, Andhra Pradesh, Punjab, Gujarat and Odisha. The core of that work is institutional: schools, colleges, hospitals and hostels, alongside townships, bungalows and commercial buildings.</p>
          <blockquote class="pull display-3xl"><p>Twenty-five years of experience, in every field.</p></blockquote>
        </section>

        <section id="approach" class="prose__section">
          <h2 class="prose__h display-2xl">Approach</h2>
          <p>An institution is built once and used for generations. We start from how the building will be used, by whom, and in what climate, and let the plan follow. Unique ideas and global trends inform the work; the site, the budget and the programme decide it.</p>
          <p>Projects of this scale need more than a single studio. K2 has fostered partnerships and consortiums with national organisations so that clients receive added value at every stage, from master plan to handover.</p>
          <blockquote class="pull display-3xl"><p>The plan follows the people who will use it.</p></blockquote>
        </section>

        <section id="sectors" class="prose__section">
          <h2 class="prose__h display-2xl">Sectors</h2>
          <dl class="deflist">
            {sectors.map((s) => (
              <div class="deflist__row">
                <dt><span class="tnum label muted">{s.index}</span> <span class="deflist__name">{s.name}</span></dt>
                <dd class="muted">{s.line}</dd>
              </div>
            ))}
          </dl>
          <p class="prose__link"><a href="/works" class="link">Browse the {projects.length} works <span class="arrow">→</span></a></p>
        </section>

        <section id="people" class="prose__section">
          <h2 class="prose__h display-2xl">People</h2>
          <p>The studio is led by Principal Architect Ar. Sachin Kothari and Landscape Architect Ar. Riya Kothari, with Ar. Mustan and Er. Lata in charge of the studio.</p>
          <ul class="people">
            {people.map((m) => (
              <li class="person">
                <figure class="figure ratio-portrait person__fig"><img src={m.img.src} srcset={m.img.srcset} sizes={m.img.sizes} width={m.img.width} height={m.img.height} alt={`${m.name}, ${m.role}`} loading="lazy" decoding="async" /></figure>
                <p class="person__name">{m.name}</p>
                <p class="label muted">{m.role}</p>
              </li>
            ))}
          </ul>
        </section>

        <section id="recognition" class="prose__section">
          <h2 class="prose__h display-2xl">Recognition & Clients</h2>
          <p>The clearest recognition in institutional work is the repeat commission. Delhi Public School has commissioned K2 for campuses in {list(Array.from(new Set(dps)))}; Delhi World Public School in {list(Array.from(new Set(dwps)))}.</p>
          <p>Clients include {list(clientNames)}, along with the trusts, promoters and developers behind the works in the portfolio.</p>
          <ul class="client-list">
            {clients.map((c) => <li>{c.name}</li>)}
          </ul>
          <blockquote class="pull display-3xl"><p>Recognition, in this work, is being asked back.</p></blockquote>
        </section>
      </article>
    </div>
  </section>
</Base>

<style>
  .studio { padding-top: clamp(7rem, 16vw, 12rem); padding-bottom: var(--section); }
  .studio__head { row-gap: 1.5rem; align-items: end; }
  .studio__title { grid-column: 1 / -1; max-width: 12ch; margin-left: -0.03em; }
  .studio__lede { grid-column: 1 / -1; }
  @media (min-width: 64rem) { .studio__title { grid-column: 1 / span 8; } .studio__lede { grid-column: 9 / span 4; padding-bottom: 0.4rem; } }
  .studio__hero { margin-top: clamp(3rem, 6vw, 5rem); }
  .studio__hero-cap { margin-top: 0.75rem; }
  .studio__body { display: grid; grid-template-columns: 1fr; gap: 3rem var(--gutter); margin-top: var(--section); }
  @media (min-width: 64rem) { .studio__body { grid-template-columns: 3fr 1fr 7fr 1fr; } .studio__side { grid-column: 1; } .prose { grid-column: 3; } }
  .studio__side { align-self: start; position: sticky; top: 6rem; }
  .toc ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-rule); }
  .toc li { border-bottom: 1px solid var(--color-rule); }
  .toc__link { display: block; padding: 0.7rem 0; font-size: var(--text-sm); color: var(--color-ink-2); transition: color var(--dur-hover) var(--ease), padding-left var(--dur-hover) var(--ease); }
  .toc__link:hover, .toc__link.is-active { color: var(--color-ink); }
  .toc__link.is-active { padding-left: 0.5rem; box-shadow: inset 2px 0 0 var(--color-accent); }
  .toc__n { color: var(--color-ink-2); margin-right: 0.5rem; font-size: var(--text-2xs); letter-spacing: var(--tracking-label); }
  @media (max-width: 63.99rem) { .studio__side { position: static; } .toc ol { display: flex; flex-wrap: wrap; gap: 0 1.5rem; border-top: 0; } .toc li { border: 0; } }

  .prose { max-width: 66ch; }
  .prose__section { padding-top: 1rem; border-top: 1px solid var(--color-rule); scroll-margin-top: 6rem; }
  .prose__section + .prose__section { margin-top: var(--section-sm); }
  .prose__h { margin-bottom: 1.5rem; }
  .prose p + p { margin-top: 1.1em; }
  .prose__link { margin-top: 1.5rem; font-size: var(--text-sm); }
  .pull { margin: clamp(2.5rem, 5vw, 4rem) 0 0 -0.02em; max-width: 14ch; text-wrap: balance; }
  .pull p { font-style: italic; }
  .deflist { margin: 0; }
  .deflist__row { display: grid; gap: 0.35rem; padding: 1rem 0; border-bottom: 1px solid var(--color-rule); }
  @media (min-width: 48rem) { .deflist__row { grid-template-columns: 1fr 1fr; gap: var(--gutter); align-items: baseline; } }
  .deflist__name { font-family: var(--font-display); font-size: var(--text-xl); line-height: 1.05; letter-spacing: -0.015em; }
  .deflist dt .label { margin-right: 0.4rem; }
  dd { margin: 0; font-size: var(--text-sm); }
  .people { list-style: none; margin: 2rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem var(--gutter); }
  @media (min-width: 48rem) { .people { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .person__fig img { object-position: center top; filter: grayscale(1) contrast(1.04) sepia(0.06); transition: filter 500ms var(--ease); }
  .person:hover .person__fig img { filter: grayscale(0) contrast(1.04) saturate(0.9) sepia(0.06); }
  .person__name { margin-top: 0.75rem; font-size: var(--text-sm); }
  .client-list { list-style: none; margin: 1.5rem 0 0; padding: 0; columns: 2; column-gap: var(--gutter); font-size: var(--text-sm); color: var(--color-ink-2); }
  .client-list li { padding: 0.45rem 0; border-bottom: 1px solid var(--color-rule); break-inside: avoid; }
</style>

<script>
  function initToc() {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc]');
    if (!links.length) return;
    const map = new Map(Array.from(links).map((l) => [l.dataset.toc!, l]));
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { links.forEach((l) => l.classList.remove('is-active')); map.get(e.target.id)?.classList.add('is-active'); } });
    }, { rootMargin: '-30% 0px -60% 0px' });
    map.forEach((_, id) => { const s = document.getElementById(id); if (s) io.observe(s); });
  }
  document.addEventListener('astro:page-load', initToc);
</script>
