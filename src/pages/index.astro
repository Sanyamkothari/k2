---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Credentials from '../components/home/Credentials.astro';
import SelectedWorks from '../components/home/SelectedWorks.astro';
import SectorIndex from '../components/home/SectorIndex.astro';
import Manifesto from '../components/home/Manifesto.astro';
import Team from '../components/home/Team.astro';
import Clients from '../components/home/Clients.astro';
import Faq from '../components/home/Faq.astro';
import Closing from '../components/home/Closing.astro';
import { site, faqs } from '../lib/site';

const webSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: Astro.site?.toString(),
};

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<Base title={site.name} transparentNav jsonLd={[webSite, faqPage]}>
  <Hero />
  <Credentials />
  <SelectedWorks />
  <SectorIndex />
  <Manifesto />
  <Team />
  <Clients />
  <Faq />
  <Closing />
</Base>
