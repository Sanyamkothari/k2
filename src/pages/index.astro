---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Credentials from '../components/home/Credentials.astro';
import SelectedWorks from '../components/home/SelectedWorks.astro';
import SectorIndex from '../components/home/SectorIndex.astro';
import Manifesto from '../components/home/Manifesto.astro';
import Team from '../components/home/Team.astro';
import Clients from '../components/home/Clients.astro';
import Closing from '../components/home/Closing.astro';
import { site } from '../lib/site';

const webSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: Astro.site?.toString(),
};
---

<Base title={site.name} transparentNav jsonLd={[webSite]}>
  <Hero />
  <Credentials />
  <SelectedWorks />
  <SectorIndex />
  <Manifesto />
  <Team />
  <Clients />
  <Closing />
</Base>
