---
import Base from '../layouts/Base.astro';
import { site } from '../lib/site';

const contactPoint = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Studio & Consultations — K2 Architects',
  description: 'Initiate an architectural dialogue or consultation with K2 Architects in Nagpur, Maharashtra for educational campuses, hospital design, and banquet complexes.',
  url: new URL('/contact', Astro.site).toString(),
  mainEntity: {
    '@id': new URL('/#organization', Astro.site).toString(),
  },
};
---

<Base title="Contact & Consultations" description="Consult with K2 Architects in Nagpur for educational campuses, hospital architecture, banquet complexes, and residences all over India." jsonLd={[contactPoint]}>
  <section class="contact container-x">
    <div class="contact__grid">
      <div class="contact__left">
        <h1 class="display-hero contact__title" data-split>Let's talk.</h1>
        <dl class="contact__list" data-reveal data-delay="0.2">
          <div>
            <dt class="label muted">Phone</dt>
            <dd><a class="link contact__big" href={`tel:+91${site.phone}`}>{site.phoneDisplay}</a></dd>
          </div>
          <div>
            <dt class="label muted">Email</dt>
            <dd><a class="link contact__big" href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          <div>
            <dt class="label muted">Studio</dt>
            <dd>
              <a class="link" href={site.mapLink} target="_blank" rel="noopener">
                {site.address.line1}, {site.address.line2},<br />{site.address.line3}
              </a>
            </dd>
          </div>
          <div>
            <dt class="label muted">Hours</dt>
            <dd>{site.hours}</dd>
          </div>
        </dl>
      </div>

      <div class="contact__right" data-reveal data-delay="0.3">
        <div class="enquiry-card">
          <p class="label muted enquiry-card__badge">Project Consultations</p>
          <h2 class="display-xl enquiry-card__title">Direct Dialogue with Principal Architects</h2>
          <p class="muted enquiry-card__intro">
            We welcome commissions and design consultations for educational campuses, multi-speciality hospital complexes, banquet venues, and residential developments across India.
          </p>

          <div class="enquiry-card__actions">
            <a href={`mailto:${site.email}?subject=Project%20Enquiry%20%E2%80%94%20K2%20Architects`} class="btn-primary">
              Email the studio <span class="arrow">→</span>
            </a>
            <a href={`tel:+91${site.phone}`} class="link contact__call-link">
              Or call {site.phoneDisplay}
            </a>
          </div>

          <div class="enquiry-card__notes">
            <div class="enquiry-note">
              <span class="label muted">What to share in your brief</span>
              <p>Project type (school, college, hospital, banquet, or residential), proposed site location, approximate plot area, and anticipated schedule.</p>
            </div>
            <div class="enquiry-note">
              <span class="label muted">Studio response</span>
              <p>Our principal studio team reviews every enquiry and replies within two working days.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="map" data-reveal>
      <iframe
        src={site.mapEmbed}
        title="Map showing the K2 Architects studio at Ozone Apartments, Amravati Road, Nagpur"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
      <p class="label muted map__cap">Ozone Apartments, Amravati Road, Nagpur · <a class="link" href={site.mapLink} target="_blank" rel="noopener">Directions</a></p>
    </div>
  </section>
</Base>

<style>
  .contact { padding-top: clamp(7rem, 16vw, 12rem); padding-bottom: var(--section); }
  .contact__grid { display: grid; grid-template-columns: 1fr; gap: 4rem var(--gutter); }
  @media (min-width: 64rem) { .contact__grid { grid-template-columns: 6fr 1fr 5fr; } .contact__right { grid-column: 3; } }
  .contact__title { margin-left: -0.04em; }
  .contact__list { display: grid; gap: 1.75rem; margin: clamp(2.5rem, 5vw, 4rem) 0 0; padding-top: 1.5rem; border-top: 1px solid var(--color-rule); }
  .contact__list dt { margin-bottom: 0.35rem; }
  .contact__list dd { margin: 0; line-height: 1.5; }
  .contact__big { font-family: var(--font-display); font-size: var(--text-xl); line-height: 1.1; letter-spacing: -0.015em; }

  .enquiry-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule);
  }
  @media (min-width: 64rem) {
    .enquiry-card { padding-top: 0; border-top: 0; margin-top: 0.75rem; }
  }
  .enquiry-card__badge { letter-spacing: var(--tracking-label); text-transform: uppercase; }
  .enquiry-card__title { margin: 0; font-family: var(--font-display); font-size: var(--text-2xl); line-height: 1.05; letter-spacing: -0.02em; }
  .enquiry-card__intro { font-size: var(--text-sm); line-height: 1.6; margin: 0; }
  .enquiry-card__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; margin-top: 0.5rem; }
  .contact__call-link { font-size: var(--text-sm); }

  .enquiry-card__notes {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule);
  }
  .enquiry-note { display: grid; gap: 0.35rem; }
  .enquiry-note p { margin: 0; font-size: var(--text-sm); line-height: 1.55; color: var(--color-ink-2); }

  .map { margin-top: var(--section); }
  .map iframe { display: block; width: 100%; aspect-ratio: 16 / 7; min-height: 320px; border: 1px solid var(--color-rule); filter: grayscale(1) contrast(0.95) sepia(0.08); transition: filter 500ms var(--ease); }
  .map:hover iframe { filter: grayscale(0.4) contrast(0.98) sepia(0.04); }
  .map__cap { margin-top: 0.75rem; }
</style>
