{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "allowJs": true
  },
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": ["dist", "archive", "hostels", "gdoc_extracted"]
}
